def get_user_from_session(self, session_id):
        cursor = self.get_cursor()

        cursor.execute(
            """SELECT users.id, users.username
            FROM users
            JOIN sessions ON users.id = sessions.user_id
            WHERE sessions.id = ''';""" % (session_id,))

        users = cursor.fetchall()
        cursor.close()

        if len(users) == 1:
            return users[0]

        return None
